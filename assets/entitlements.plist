<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- WKWebView requires JIT compilation for JavaScript -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>

    <!-- WKWebView needs unsigned executable memory for JS engine -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <!-- Allow loading dylibs not signed by Apple (wry/WebKit internals) -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- Outbound network access — browser needs this -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- Camera device access for getUserMedia() -->
    <key>com.apple.security.device.camera</key>
    <true/>

    <!-- Microphone device access for getUserMedia() -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
