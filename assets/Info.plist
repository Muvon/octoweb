<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>Octoweb</string>

    <key>CFBundleDisplayName</key>
    <string>Octoweb</string>

    <key>CFBundleIdentifier</key>
    <string>io.muvon.octoweb</string>

    <key>CFBundleVersion</key>
    <string>1</string>

    <key>CFBundleShortVersionString</key>
    <string>0.10.0</string>

    <key>CFBundlePackageType</key>
    <string>APPL</string>

    <key>CFBundleSignature</key>
    <string>????</string>

    <key>CFBundleExecutable</key>
    <string>octoweb</string>

    <key>CFBundleIconFile</key>
    <string>icon</string>

    <key>NSPrincipalClass</key>
    <string>NSApplication</string>

    <!-- Retina / high-DPI support -->
    <key>NSHighResolutionCapable</key>
    <true/>

    <!-- Required for WKWebView to load http:// and arbitrary URLs (browser use case) -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <true/>
    </dict>

    <!-- Accessibility API — required for CGEventTap global hotkeys -->
    <key>NSAppleEventsUsageDescription</key>
    <string>Octoweb uses accessibility features for global keyboard shortcuts.</string>

    <!-- Camera access for websites (video calls, etc.) -->
    <key>NSCameraUsageDescription</key>
    <string>Octoweb needs camera access for websites that request it (e.g. video calls).</string>

    <!-- Microphone access for websites (voice/video calls, etc.) -->
    <key>NSMicrophoneUsageDescription</key>
    <string>Octoweb needs microphone access for websites that request it (e.g. voice/video calls).</string>

    <!-- Speech recognition for websites using Web Speech API (SpeechRecognition).
         Without this key WKWebView fails immediately with `service-not-allowed`,
         because the system has no copy to show in the permission prompt. -->
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>Octoweb needs speech recognition for websites that use the Web Speech API (e.g. dictation, voice input).</string>

    <!-- Location access for websites using HTML5 geolocation -->
    <key>NSLocationUsageDescription</key>
    <string>Octoweb needs location access for websites that request it (e.g. maps, local search).</string>
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>Octoweb needs location access for websites that request it (e.g. maps, local search).</string>

    <!-- Local network access (macOS Sequoia+): required for sites that talk to
         localhost / LAN services such as uTorrent Web, Plex, dev servers, etc. -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>Octoweb needs local network access for websites that connect to apps on this Mac or your LAN (e.g. uTorrent Web, Plex, dev servers).</string>

    <!-- Bonjour service types we may discover on the local network. The wildcards
         cover the common service families used by web-based local apps. -->
    <key>NSBonjourServices</key>
    <array>
        <string>_http._tcp</string>
        <string>_https._tcp</string>
        <string>_utweb._tcp</string>
    </array>

    <!-- Minimum macOS version -->
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>

    <!-- Disable automatic termination - browsers should persist -->
    <key>NSSupportsAutomaticTermination</key>
    <false/>

    <!-- Suppress dock icon bounce on launch -->
    <key>LSUIElement</key>
    <false/>

    <!-- Register as a web browser — required for "Default web browser" in System Settings -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>Web site URL</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>http</string>
                <string>https</string>
            </array>
        </dict>
    </array>

    <!-- Handle HTML document types — also needed for browser recognition -->
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>
            <string>HTML document</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>public.html</string>
            </array>
        </dict>
        <dict>
            <key>CFBundleTypeName</key>
            <string>XHTML document</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>public.xhtml</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
